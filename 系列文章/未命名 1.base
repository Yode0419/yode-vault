filters:
  and:
    - file.inFolder("系列文章")
views:
  - type: kanban-view
    name: 檢視
    order:
      - file.name
      - tags
    columnOrders:
      file.file:
        - 系列文章/文章 1.md
        - 系列文章/文章 2.md
        - 系列文章/文章 3.md
        - 系列文章/文章 4.md
        - 系列文章/未命名 1.base
      note.test:
        - Uncategorized
        - a
    cardOrders:
      file.file:
        Clippings/Design a Mobile App UI from SCRATCH in under 8 minutes (beginner friendly).md:
          - Clippings/Design a Mobile App UI from SCRATCH in under 8 minutes (beginner friendly).md
      note.test: {}
    columnColors:
      file.file: {}
      note.test: {}
    imageAspectRatio: 0.55
    wrapPropertyValues: false
    groupByProperty: note.test
